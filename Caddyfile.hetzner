:80 {
	encode zstd gzip

	root * /srv
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@version path /version.json
	header @version Cache-Control "no-store"

	@spaFallback {
		not path /assets/* /version.json
	}
	header @spaFallback Cache-Control "no-store, no-cache, must-revalidate"

	try_files {path} /index.html
	file_server
}
